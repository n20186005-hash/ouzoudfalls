---
import type {Locale} from '../i18n';
import {site} from '../data/site';
interface Props{locale:Locale;conditions:Record<number,{t:string;i:string}>;}
const {locale,conditions}=Astro.props;
const C={
 ar:{title:'توقع الطقس الإقليمي',note:'نموذج قرب أوزود، لا محطة عند الشلال أو إعلان فتح وسلامة.',loading:'جار طلب توقع حديث…',error:'لا تتوفر بيانات حديثة موثوقة الآن. لا نعرض أرقاماً قديمة أو بديلة.',temp:'الحرارة',wind:'الرياح',rain:'احتمال المطر اليومي الأقصى',uv:'أقصى UV يومي',model:'وقت النموذج',retrieved:'وقت الطلب',thunder:'إشارة رعد في النموذج؛ تحقق من التحذيرات وحالة الوصول قبل الانطلاق.',heavyRain:'إشارة مطر غزير في النموذج؛ تحقق من التحذيرات والمسارات محلياً.',fog:'إشارة ضباب في النموذج؛ تحقق من الرؤية وظروف الطريق.',limits:'التوقع لا يقيس قوة النهر أو الحوض الأعلى ولا يؤكد نشاطاً أو دخولاً آمناً. التحديث كل 15 دقيقة ما دامت الصفحة نشطة؛ فشل الطلب يمسح الأرقام.'},
 en:{title:'Regional weather forecast',note:'Model near Ouzoud, not a waterfall weather station or an access/safety clearance.',loading:'Requesting a fresh forecast…',error:'Fresh valid forecast unavailable. Old or substitute numbers are not displayed.',temp:'Temperature',wind:'Wind',rain:'Daily maximum rain probability',uv:'Daily maximum UV',model:'Model time',retrieved:'Retrieved',thunder:'Thunder model signal: check official warnings and local access before departure.',heavyRain:'Heavy-rain model signal: check official warnings and local route conditions.',fog:'Fog model signal: check road visibility and conditions.',limits:'A regional forecast does not measure river force or the full upstream catchment and cannot confirm an activity or safe access. Refreshes every15minutes while active; failed requests clear the numbers.'},
 fr:{title:'Prévision météo régionale',note:'Modèle près d’Ouzoud, pas une station aux chutes ni une autorisation d’accès ou de sécurité.',loading:'Demande de prévision récente…',error:'Prévision récente valide indisponible. Aucun ancien chiffre ou substitut n’est affiché.',temp:'Température',wind:'Vent',rain:'Probabilité de pluie maximale du jour',uv:'UV maximal du jour',model:'Heure du modèle',retrieved:'Consulté',thunder:'Signal d’orage du modèle: vérifiez les alertes officielles et l’accès local.',heavyRain:'Signal de fortes pluies: vérifiez les alertes officielles et les chemins localement.',fog:'Signal de brouillard: vérifiez visibilité et conditions routières.',limits:'La prévision ne mesure ni force de la rivière ni tout le bassin versant et ne confirme ni activité ni accès sûr. Actualisation toutes les15minutes en page active; un échec efface les chiffres.'},
 zh:{title:'区域天气预报',note:'奥祖德附近的模型，不是瀑布气象站实测，也不是通行或安全许可。',loading:'正在请求新预报…',error:'暂时没有足够新且有效的预报，不显示旧数值或替代值。',temp:'气温',wind:'风速',rain:'当日最高降雨概率',uv:'当日最高紫外线指数',model:'模型时间',retrieved:'取得时间',thunder:'模型出现雷暴信号：出发前查官方警示及当地通行消息。',heavyRain:'模型出现强降雨信号：查官方警示与当地路径状态。',fog:'模型出现雾信号：查道路能见度与路况。',limits:'区域预报不能测量河流力量或代表整个上游汇水区，也不确认活动运营或可安全通行。页面活跃时每15分钟更新，失败会清除数值。'}
}[locale];
---
<section id="weather" class="bg-[#eef3f1] px-5 py-20"><div class="mx-auto max-w-7xl"><h2 class="section-title">{C.title}</h2><p class="mt-4 leading-8">{C.note}</p><div id="weather-root" class="mt-7" data-lat={site.latitude} data-lon={site.longitude} data-locale={locale} aria-live="polite">{C.loading}</div><script is:inline type="application/json" id="weather-copy" set:html={JSON.stringify({copy:C,conditions})}/><p class="mt-6 text-sm leading-7">{C.limits}</p><p class="mt-3 text-sm"><a class="underline" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a> · <a class="underline" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY4.0</a></p></div></section>
<script>
import {parseForecast,modelSignal} from '../lib/weather-model';
const root=document.getElementById('weather-root');const data=document.getElementById('weather-copy');
if(root&&data){
 const {copy:C,conditions}=JSON.parse(data.textContent||'{}');const locale=root.dataset.locale||'en';let last=0;let loading=false;
 const make=(tag:string,text:string,cls='')=>{const element=document.createElement(tag);element.textContent=text;element.className=cls;return element;};
 const clear=()=>{root.replaceChildren(make('p',C.error,'card p-6'));last=0;};
 const load=async()=>{if(loading)return;loading=true;try{
  const url=new URL('https://api.open-meteo.com/v1/forecast');url.search=new URLSearchParams({latitude:root.dataset.lat||'',longitude:root.dataset.lon||'',current:'temperature_2m,weather_code,wind_speed_10m',daily:'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max',timezone:'Africa/Casablanca',forecast_days:'7'}).toString();
  const response=await fetch(url,{signal:AbortSignal.timeout(8000)});if(!response.ok)throw Error('status');const report=parseForecast(await response.json());if(!report)throw Error('invalid');
  const now=report.current,today=report.days[0];const card=make('div','','card p-6');card.append(make('h3',`${C.temp}: ${Math.round(now.temperature)}°C`,'text-2xl font-bold'),make('p',conditions[now.code]?.t||''),make('p',`${C.wind}: ${Math.round(now.wind)} km/h`),make('p',`${C.rain}: ${today.probability}%`));if(today.uv!==null)card.append(make('p',`${C.uv}: ${today.uv}`));const signal=modelSignal(now.code);if(signal)card.append(make('p',C[signal],'mt-4 font-bold text-red-800'));
  card.append(make('p',`${C.model}: ${report.modelTime} · Africa/Casablanca`,'mt-4 text-sm'),make('p',`${C.retrieved}: ${new Date(report.retrievedAt).toLocaleString(locale,{timeZone:'Africa/Casablanca'})}`,'text-sm'));
  const grid=make('div','','mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4');for(const day of report.days){const item=make('div','','card p-4');item.append(make('h3',day.date,'font-bold'),make('p',conditions[day.code]?.t||''),make('p',`${Math.round(day.min)}° / ${Math.round(day.max)}°C`),make('p',`${C.rain}: ${day.probability}%`));grid.append(item);}root.replaceChildren(card,grid);last=Date.now();
 }catch{clear();}finally{loading=false;}};
 load();setInterval(()=>{if(document.visibilityState==='visible')load();else if(last&&Date.now()-last>30*60000)clear();},15*60000);document.addEventListener('visibilitychange',()=>{if(document.visibilityState!=='visible')return;if(last&&Date.now()-last>30*60000)clear();if(!last||Date.now()-last>15*60000)load();});
}
</script>
