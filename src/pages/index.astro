---
import '../styles/global.css';

const site = Astro.site;
const pagePath = '/';
const canonical = site ? new URL(pagePath, site).href : undefined;
const domain = 'ouzoudfalls.com';
const ogImagePath = '/images/og-oujoud.svg';
const ogImage = site ? new URL(ogImagePath, site).href : undefined;

const attraction = {
  name: 'شلالات أوزود',
  fullName: 'شلالات أوزود',
  shortName: 'أوزود',
  alternateName: ['أوزود', "Cascades d'Ouzoud", 'Ouzoud Waterfalls'],
  city: 'أوزود',
  province: 'أزيلال',
  region: 'بني ملال خنيفرة',
  country: 'المغرب',
  countryCode: 'MA',
  postalCode: '22576',
  address: '277H+4VW Cascades Ouzoud, Ouzoud 22576, Morocco',
  latitude: 32.0152,
  longitude: -6.71933,
  rating: 4.6,
  reviewCount: 20029,
  ratingSource: 'خرائط Google',
  ratingSync: 'سبتمبر 2026',
  mapsShareUrl: 'https://maps.app.goo.gl/cz7ABdpCUsSBKMXF6',
  mapsEmbedSrc: 'https://www.google.com/maps?q=277H%2B4VW%20Cascades%20Ouzoud%2C%20Ouzoud%2022576%2C%20Morocco&output=embed&hl=ar',
  nearbyLandmark1: 'إيمي نفري (الجسر الطبيعي)',
  nearbyLandmark2: 'وادي أوزود والينابيع',
  tourismUrl: 'https://www.visitmorocco.com/'
};

const faqs = [
  ['أين تقع شلالات أوزود؟', 'تقع شلالات أوزود في قرية أوزود بإقليم أزيلال، ضمن جهة بني ملال خنيفرة في المغرب، على بُعد نحو 180 كم من مراكش.'],
  ['هل دخول شلالات أوزود مجاني؟', 'الوصول إلى الموقع الطبيعي نفسه مجاني عادةً، بينما تُدفع خدمات اختيارية مثل مواقف السيارات والقوارب والمرشدين والطعام بشكل منفصل.'],
  ['كم من الوقت أحتاج للزيارة؟', 'خصص ما بين 3 و5 ساعات للمشي والنزول إلى أسفل الشلال والتوقف عند نقاط المشاهدة وتناول وجبة بهدوء.'],
  ['ما أفضل وقت خلال اليوم؟', 'الصباح الباكر أهدأ عادةً، بينما قد تُظهر شمس الظهيرة أقواس قزح داخل رذاذ الشلال. تجنب الأحذية الملساء بعد المطر.'],
  ['هل يمكن الوصول بالسيارة؟', 'نعم، تصل الطرق إلى قرية أوزود ثم تكمل سيراً على الأقدام عبر المسارات المؤدية إلى نقاط المشاهدة وقاع الوادي.'],
  ['هل توجد قرود في المنطقة؟', 'تُشاهد قرود المكاك البربري أحياناً في المنطقة. الأفضل عدم إطعامها أو الاقتراب منها بشكل يزعجها.'],
  ['ما أهمية شلالات أوزود؟', 'تُعد شلالات أوزود من أشهر الوجهات الطبيعية في المغرب، وتتميز بارتفاع يقارب 110 م وبيئة وادٍ مغطاة بأشجار الزيتون حول ضفتي الوادي.']
];

const touristJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${canonical || 'https://' + domain}/#attraction`,
  name: attraction.fullName,
  alternateName: attraction.alternateName,
  description: `دليل زيارة شامل لـ ${attraction.fullName} في ${attraction.city}، ${attraction.province}، ${attraction.country}.`,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '277H+4VW Cascades Ouzoud',
    addressLocality: 'Ouzoud',
    addressRegion: 'Azilal',
    postalCode: '22576',
    addressCountry: 'MA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59'
  }],
  hasMap: attraction.mapsShareUrl,
  sameAs: [attraction.mapsShareUrl, attraction.tourismUrl]
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q,a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>شلالات أوزود (أوزود، أزيلال) | دليل الزيارة والطريق والطعام</title>
  <meta name="description" content={`دليل عربي شامل لزيارة ${attraction.fullName} في ${attraction.city} بإقليم ${attraction.province}، ${attraction.country}: أفضل وقت، الطريق، المواقف، التكاليف، الطعام، المشي ونقاط المشاهدة.`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="شلالات أوزود (أوزود) | دليل الزيارة" />
  <meta property="og:description" content={`خطة لزيارة ${attraction.fullName} في ${attraction.city}، ${attraction.province}، ${attraction.country}: المسار، الوقت، الطعام، المواقف والتكاليف العملية.`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${attraction.fullName} في ${attraction.city}، ${attraction.country}`} />
  <meta name="theme-color" content="#211916" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
  <script type="application/ld+json" set:html={JSON.stringify(touristJsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HXM22WWPKP');
  </script>
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</head>
<body>
  <header class="fixed top-0 z-50 w-full border-b border-white/15 bg-[#211916]/70 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3">
      <a href="#top" aria-label="الرئيسية"><img src="/logo.svg" alt="شعار شلالات أوزود" class="h-12 w-auto" /></a>
      <nav class="hidden gap-6 text-sm font-bold text-white md:flex">
        <a href="#about">عن أوزود</a><a href="#visit">الزيارة</a><a href="#transport">الوصول</a><a href="#food">الطعام</a><a href="#nearby">حول أوزود</a><a href="#reviews">التقييمات</a><a href="#weather">الطقس</a><a href="#faq">الأسئلة</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="relative min-h-[92vh] overflow-hidden bg-[#2d241f] text-white">
      <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Ouzoud_Falls,_Morocco,_20250126_1133_7340.jpg?width=2200" alt={`منظر حقيقي لـ ${attraction.fullName} والوادي الأحمر في ${attraction.city}، ${attraction.country}`} class="absolute inset-0 h-full w-full object-cover opacity-75" />
      <div class="absolute inset-0 bg-gradient-to-l from-[#251b17]/95 via-[#251b17]/45 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#f3efe6] to-transparent"></div>
      <div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-end px-5 pb-24 pt-32 md:items-center md:pb-12">
        <div class="max-w-3xl">
          <p class="kicker mb-5 text-[#f0c39e]">إقليم أزيلال · بني ملال خنيفرة</p>
          <h1 class="text-5xl font-black leading-[1.05] md:text-8xl">{attraction.name.split(' ')[0]}<br/><span class="text-[#d9e8df]">{attraction.name.split(' ')[1]}</span></h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/85 md:text-xl">مياه تهبط عبر صخور حمراء ووادٍ مغطى بالزيتون؛ رحلة تتبدّل فيها المشاهد مع كل منعطف، من الحافة العليا إلى ضفة النهر.</p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm font-bold">
            <span class="rounded-full bg-white/15 px-4 py-2 backdrop-blur">ارتفاع يقارب 110 م</span>
            <span class="rounded-full bg-white/15 px-4 py-2 backdrop-blur">⭐ {attraction.rating}/5 · {attraction.reviewCount.toLocaleString('ar-EG')} تقييماً</span>
            <span class="rounded-full bg-white/15 px-4 py-2 backdrop-blur">الدخول للموقع الطبيعي مجاني</span>
          </div>
          <p class="mt-3 text-xs text-white/55">التقييم وعدد التقييمات مُزامَنان من تقييمات مستخدمي خرائط Google (Google Maps) · {attraction.ratingSync} · <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="underline">اطّلع على جميع تقييمات خرائط Google ↗</a></p>
        </div>
      </div>
    </section>

    <section id="about" class="grain py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <div class="grid gap-8 lg:grid-cols-[1.1fr_.9fr]">
          <div>
            <p class="kicker text-[var(--clay)]">عن الوجهة</p>
            <h2 class="section-title mt-3">حول {attraction.fullName}</h2>
            <p class="mt-6 max-w-2xl text-lg leading-9 text-stone-700">أهلاً بك في <strong>{attraction.fullName}</strong>، المعروفة على نطاق واسع باسم <strong>{attraction.shortName}</strong>. تقع في قلب <strong>{attraction.city}</strong> بإقليم <strong>{attraction.province}</strong> في <strong>{attraction.country}</strong>، وتُعد وجهةً رئيسية للمسافرين إلى المنطقة.</p>
            <p class="mt-4 text-sm font-bold tracking-wide text-stone-500">{attraction.fullName} ← {attraction.city} ← {attraction.province} ← {attraction.country}</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="card p-6"><div class="text-3xl">⏱</div><h3 class="mt-4 font-black">المدة المقترحة</h3><p class="mt-2 text-stone-600">3–5 ساعات لزيارة مريحة تشمل النزول والعودة ووجبة.</p></div>
            <div class="card p-6"><div class="text-3xl">☀</div><h3 class="mt-4 font-black">أفضل وقت</h3><p class="mt-2 text-stone-600">الصباح للهدوء، ومنتصف النهار لرؤية الضوء داخل رذاذ الشلال.</p></div>
            <div class="card p-6"><div class="text-3xl">🎟</div><h3 class="mt-4 font-black">الدخول</h3><p class="mt-2 text-stone-600">الوصول إلى الموقع الطبيعي بلا تذكرة دخول؛ الخدمات الاختيارية مدفوعة.</p></div>
            <div class="card p-6"><div class="text-3xl">🥾</div><h3 class="mt-4 font-black">المسار</h3><p class="mt-2 text-stone-600">درجة سهلة إلى متوسطة، لكن الانحدار والسطح المبتل يحتاجان انتباهاً.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="visit" class="bg-[#4d5b35] py-20 text-white md:py-28">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 md:grid-cols-12">
        <div class="md:col-span-7"><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Ouzoud_waterfalls_In_spring-Morocco.jpg?width=1800" alt={`${attraction.fullName} في الربيع قرب ${attraction.city}، ${attraction.country}`} class="h-[520px] w-full rounded-[2rem] object-cover shadow-2xl" /></div>
        <div class="flex flex-col justify-end md:col-span-5 md:pb-8">
          <p class="kicker text-[#dfe9d5]">الماء والواحة</p><h2 class="section-title mt-3">صخر أحمر، زيتون وماء أبيض</h2><p class="mt-6 text-lg leading-9 text-white/80">المشهد المميز هنا ليس الشلال وحده؛ اللون الطيني للجروف، النباتات على ضفتي الوادي، وصوت الماء يخلقون هوية بصرية مختلفة عن المدن المغربية.</p>
        </div>
      </div>
    </section>

    <section id="transport" class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <p class="kicker text-[var(--clay)]">التنقل</p><h2 class="section-title mt-3">الموقع والوصول إلى {attraction.shortName} في {attraction.city}</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <article class="card p-7"><h3 class="text-xl font-black">من مراكش</h3><p class="mt-3 leading-8 text-stone-600">المسافة البرية تقارب 180 كم. تستغرق الرحلة عادةً نحو 2.5–3.5 ساعات بحسب الطريق والتوقفات. تتوفر رحلات يومية منظمة، وسيارات خاصة، ونقل مشترك.</p></article>
          <article class="card p-7"><h3 class="text-xl font-black">بالسيارة</h3><p class="mt-3 leading-8 text-stone-600">استخدم اتجاه Ouzoud / Azilal ثم اتبع اللافتات إلى منطقة الشلالات. الطرق الأخيرة جبلية نسبياً، فخفف السرعة خصوصاً بعد الغروب أو المطر.</p></article>
          <article class="card p-7"><h3 class="text-xl font-black">مواقف السيارات</h3><p class="mt-3 leading-8 text-stone-600">توجد مواقف خاصة قرب مداخل المسارات. رسوم المواقف تختلف حسب الموقع والموسم؛ اسأل عن السعر قبل ترك السيارة واحتفظ بنقود مغربية صغيرة.</p></article>
        </div>
        <div class="mt-10 overflow-hidden rounded-[2rem] border border-stone-300 bg-white shadow-xl">
          <iframe title="خريطة شلالات أوزود" src={attraction.mapsEmbedSrc} width="100%" height="520" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <section id="food" class="bg-[#51261d] py-20 text-white md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <p class="kicker text-[#efc4aa]">حول المائدة</p><h2 class="section-title mt-3">أكل محلي بعد المشي</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <div class="rounded-3xl border border-white/15 p-7"><h3 class="text-xl font-black">Chez Mounir</h3><p class="mt-3 leading-8 text-white/70">من الخيارات المعروفة قرب الشلال، ويقدم أطباقاً مغربية مناسبة لوجبة بعد النزول.</p></div>
          <div class="rounded-3xl border border-white/15 p-7"><h3 class="text-xl font-black">Restaurant Chez Rachid</h3><p class="mt-3 leading-8 text-white/70">مطعم قريب بخيارات مغربية ومتوسطية، مناسب لمن يريد وجبة سريعة قبل العودة.</p></div>
          <div class="rounded-3xl border border-white/15 p-7"><h3 class="text-xl font-black">La Table Berbere</h3><p class="mt-3 leading-8 text-white/70">خيار بطابع أمازيغي ومغربي، مع أجواء محلية قريبة من مسار الزيارة.</p></div>
        </div>
      </div>
    </section>

    <section id="nearby" class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <p class="kicker text-[var(--clay)]">قريب من الشلال</p><h2 class="section-title mt-3">معالم وأماكن حول {attraction.shortName}</h2>
        <p class="mt-6 max-w-3xl text-lg leading-9 text-stone-700">عند زيارة <strong>{attraction.fullName}</strong>، يمكن للزوّار استكشاف المعالم التاريخية ونقاط الاهتمام المحيطة بسهولة، بما في ذلك <strong>{attraction.nearbyLandmark1}</strong> و<strong>{attraction.nearbyLandmark2}</strong>.</p>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <div class="card p-7"><h3 class="text-2xl font-black">مسارات الوادي والينابيع</h3><p class="mt-3 leading-8 text-stone-600">بعد النقطة الرئيسية توجد ممرات أصغر ومشاهد للوادي والينابيع. اختر المسار وفق الوقت وحالة الأرض، ولا تدخل المقاطع الزلقة بعد المطر دون تجهيز مناسب.</p></div>
          <div class="card p-7"><h3 class="text-2xl font-black">إيمي نفري</h3><p class="mt-3 leading-8 text-stone-600">الجسر الطبيعي قرب دمنات محطة منطقية لمن يملك سيارة ويخطط ليوم أطول في المنطقة، ويمكن دمجه مع أوزود قبل العودة نحو مراكش.</p></div>
        </div>
      </div>
    </section>

    <section id="reviews" class="bg-[#f3efe6] py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <p class="kicker text-[var(--clay)]">التقييمات</p>
        <h2 class="section-title mt-3">ماذا يقول زوّار {attraction.fullName}؟</h2>
        <div class="mt-10 max-w-2xl card p-8">
          <div class="flex items-center gap-5">
            <div class="text-6xl font-black text-[var(--clay)] leading-none">{attraction.rating}</div>
            <div>
              <div class="text-2xl text-amber-500" aria-hidden="true">★★★★★</div>
              <p class="mt-1 text-stone-600 text-sm">بناءً على {attraction.reviewCount.toLocaleString('ar-EG')} تقييماً</p>
            </div>
          </div>
          <p class="mt-6 text-sm leading-7 text-stone-500">مُزامَنة من تقييمات مستخدمي خرائط Google، وقت المزامنة {attraction.ratingSync}؛ الحقوق تعود للكتّاب الأصليين وخرائط Google.</p>
          <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block rounded-full bg-[var(--clay)] px-5 py-2 text-sm font-bold text-white">عرض جميع التقييمات على خرائط Google ↗</a>
        </div>
      </div>
    </section>

    <section id="weather" class="bg-[#eef3f1] py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <p class="kicker text-[var(--clay)]">الطقس الآن</p>
        <h2 class="section-title mt-3">الطقس وتوقّعات 7 أيام في {attraction.shortName}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-stone-500">توقّعات مباشرة من Open-Meteo لنقطة الشلال؛ تُحدَّث تلقائياً في متصفّحك. النصائح مبنية على حالة الطقس ولا تغني عن متابعة التنبيهات الرسمية.</p>
        <div id="weather-root" class="mt-10" data-lat={attraction.latitude} data-lon={attraction.longitude}>
          <div class="card p-8 text-stone-500">جارٍ تحميل الطقس…</div>
        </div>
      </div>
    </section>

    <section class="bg-[#dce8e4] py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5">
        <div class="grid gap-8 lg:grid-cols-3">
          <div><p class="kicker text-[var(--clay)]">التكاليف العملية</p><h2 class="section-title mt-3">ماذا قد تدفع؟</h2></div>
          <div class="card p-7"><h3 class="font-black">تذكرة الدخول</h3><p class="mt-3 text-stone-600">لا توجد عادةً تذكرة للموقع الطبيعي نفسه.</p><h3 class="mt-6 font-black">القارب</h3><p class="mt-3 text-stone-600">اختياري ويُدفع محلياً؛ الأسعار قد تتغير حسب الموسم والتشغيل.</p></div>
          <div class="card p-7"><h3 class="font-black">موقف السيارة</h3><p class="mt-3 text-stone-600">مواقف مدفوعة صغيرة قرب المداخل؛ اتفق على السعر مسبقاً.</p><h3 class="mt-6 font-black">المرشد</h3><p class="mt-3 text-stone-600">ليس إلزامياً للمسار الرئيسي، لكنه مفيد لمن يريد شرحاً محلياً ومسارات أطول.</p></div>
        </div>
      </div>
    </section>

    <section id="faq" class="py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-5">
        <p class="kicker text-[var(--clay)]">FAQ</p><h2 class="section-title mt-3">أسئلة شائعة</h2>
        <div class="mt-10 space-y-4">
          {faqs.map(([q,a]) => <details class="card p-6"><summary class="cursor-pointer text-lg font-black">{q}</summary><p class="mt-4 leading-8 text-stone-600">{a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="border-y border-stone-300 bg-white py-12">
      <div class="mx-auto max-w-7xl px-5 text-sm leading-7 text-stone-600">
        <h2 class="mb-4 text-lg font-black text-stone-900">مصادر ومراجع</h2>
        <p class="mb-3"><strong class="text-stone-900">التقييمات · وقت المزامنة {attraction.ratingSync}:</strong> مُزامَنة من تقييمات مستخدمي خرائط Google، وقت المزامنة {attraction.ratingSync}؛ الحقوق تعود للكتّاب الأصليين وخرائط Google. <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--clay)] underline">عرض جميع التقييمات على خرائط Google ↗</a></p>
        <p class="mb-3"><strong class="text-stone-900">مصادر الصور:</strong> صور حقيقية لشلالات أوزود من Wikimedia Commons، منها أعمال Jakub Hałun وKasmii، وتُعرض وفق تراخيصها المفتوحة.</p>
        <p><strong class="text-stone-900">السياحة الرسمية:</strong> للاطلاع على التحديثات والنصائح الإقليمية، زُر <a href={attraction.tourismUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--clay)] underline">البوابة السياحية الرسمية للمغرب (Visit Morocco) ↗</a>.</p>
        <p class="mt-3 text-stone-500">المعلومات العملية جُمعت من خرائط Google ومصادر سفر محلية وعامة؛ الأسعار والخدمات الاختيارية قد تتغير.</p>
      </div>
    </section>
  </main>

  <footer class="bg-[#211916] py-10 text-center text-sm text-white/60">
    <p>هذا موقع إرشادي مستقل وغير رسمي، ولا يمثل إدارة شلالات أوزود أو أي جهة حكومية أو تجارية.</p>
  </footer>

  <script is:inline>
  (function(){
    var WEATHER = {
      0:{t:'صافٍ',i:'☀️'},1:{t:'صافٍ غالباً',i:'🌤️'},2:{t:'غائم جزئياً',i:'⛅'},3:{t:'غائم',i:'☁️'},
      45:{t:'ضباب',i:'🌫️'},48:{t:'ضباب',i:'🌫️'},
      51:{t:'رذاذ',i:'🌦️'},53:{t:'رذاذ',i:'🌦️'},55:{t:'رذاذ',i:'🌦️'},56:{t:'رذاذ متجمّد',i:'🌧️'},57:{t:'رذاذ متجمّد',i:'🌧️'},
      61:{t:'مطر خفيف',i:'🌦️'},63:{t:'مطر متوسط',i:'🌧️'},65:{t:'مطر غزير',i:'🌧️'},
      66:{t:'مطر متجمّد',i:'🌧️'},67:{t:'مطر متجمّد',i:'🌧️'},
      71:{t:'ثلج',i:'❄️'},73:{t:'ثلج',i:'❄️'},75:{t:'ثلج',i:'❄️'},77:{t:'حبيبات ثلج',i:'🌨️'},
      80:{t:'زخات مطر خفيفة',i:'🌦️'},81:{t:'زخات مطر',i:'🌧️'},82:{t:'زخات مطر غزيرة',i:'🌧️'},
      85:{t:'زخات ثلج',i:'🌨️'},86:{t:'زخات ثلج',i:'🌨️'},
      95:{t:'عاصفة رعدية',i:'⛈️'},96:{t:'عاصفة رعدية مع بَرَد',i:'⛈️'},99:{t:'عاصفة رعدية مع بَرَد',i:'⛈️'}
    };
    function beaufort(kmh){var t=[0,1,6,12,20,29,39,50,62,75,89,103],b=0;for(var i=1;i<t.length;i++){if(kmh>=t[i])b=i;}return b;}
    function wInfo(c){return WEATHER[c]||{t:'غير معروف',i:'🌡️'};}
    function buildAdvice(o){
      var a={outfit:[],play:[],items:[],risks:[]};
      var isLightRain=[51,53,55,56,57,61,80].indexOf(o.code)>=0;
      var isModRain=[63,81].indexOf(o.code)>=0;
      var isHeavyRain=[65,82].indexOf(o.code)>=0;
      var isThunder=[95,96,99].indexOf(o.code)>=0;
      var isClear=[0,1].indexOf(o.code)>=0;
      var isCloudy=[2,3].indexOf(o.code)>=0;
      var isFog=[45,48].indexOf(o.code)>=0;
      var rain=isLightRain||isModRain||isHeavyRain||isThunder;
      if(o.precip>=60){a.outfit.push('احتمال المطر مرتفع اليوم؛ يُفضّل اصطحاب مظلّة أو معطف مطر، وقدّم الزيارات الداخلية إن أمكن.');a.play.push('مع احتمال المطر القوي، أجّل النزول إلى الوادي وصعود المسارات المنحدرة.');a.items.push('مظلّة أو معطف مطر');}
      if(isLightRain){a.outfit.push('أمطار خفيفة والأرض زلقة؛ تمشَّ بخطوات حذرة والتجارب المكشوفة أقل متعة.');a.items.push('مظلّة قابلة للطي');}
      if(isModRain){a.risks.push('أمطار متوسطة: تجنّب أودية المياه والأحواض المنخفضة؛ القوارب قد تتوقف.');a.items.push('معطف مطر (تجنّب المظلّة الطويلة مع الرياح)');}
      if(isHeavyRain){a.risks.push('أمطار غزيرة: لا تقترب من حافة الشلال أو مجاري المياه الجارية؛ الأنشطة النهرية متوقفة.');a.items.push('معطف مطر مقاوم');}
      if(isThunder){a.risks.push('احذر الرعد والبرق: لا تصعد الجبل ولا تسبح ولا تقف تحت الأشجار عند المطر؛ الأنشطة المائية متوقفة غالباً.');}
      if(rain){a.play.push('عند المطر يرتفع منسوب مياه الوادي بسرعة؛ لا تقترب من حافة الشلال أو مجاري المياه الجارية، ولا تسبح دون التأكد من الأمان.');}
      if(o.tmax>=32){a.outfit.push('الحرارة مرتفعة؛ تجنّب الخروج وقت الظهيرة واختر ملابس خفيفة.');a.play.push('قصّر وقت المشي تحت الشمس واسترح في الظل.');a.items.push('واقٍ شمسي، ماء كافٍ، أدوات تبريد');}
      if(o.uv>=5){a.outfit.push('الأشعة فوق البنفسجية قوية؛ احمِ بشرتك وعينيك.');a.items.push('كريم واقٍ، نظارة شمسية، قبعة');}
      if((o.tmax-o.tmin)>8){a.outfit.push('فارق الحرارة بين النهار والليل كبير؛ احمل طبقة إضافية تلبسها وتخلعها بسهولة.');}
      if(o.tmax<=10){a.outfit.push('الحرارة منخفضة؛ دفّئ جيداً وتجنّب البقاء طويلاً تحت الماء المتساقط.');a.items.push('معطف سميك، وشاح');}
      if(o.bf>=5&&o.bf<=6){a.outfit.push('الرياح نشطة؛ القبعة قد تطير فتجنّب الثياب الواسعة.');a.play.push('رحلات البحر والأنشطة المكشوفة قد تتوقف مؤقتاً.');}
      if(o.bf>=7){a.risks.push('رياح قوية: ابتعد عن اللوحات الإعلانية وصخور الوادي؛ الأنشطة النهرية متوقفة غالباً.');}
      if(isClear){a.outfit.push('الطقس صافٍ ومناسب للتنزّه الخارجي.');a.play.push('وقت جيد لمشاهدة شروق أو غروب الشلال فوق الوادي.');a.items.push('لا تنسَ واقي الشمس');}
      if(isCloudy){a.outfit.push('الضوء ناعم ومناسب جداً للتصوير، بلا حرارة حارقة.');a.play.push('مناسب للمشي الطويل حول الوادي والمدرّجات.');}
      if(isFog){a.risks.push('الرؤية ضعيفة؛ المسارات الزلقة والجسور أصعب والرحلات قد تتأخر.');a.items.push('كن حذراً على الدرجات والحواف');}
      return a;
    }
    function block(title,arr){
      if(!arr.length)return '';
      return '<div class="rounded-2xl border border-stone-200 bg-white/80 p-5"><h4 class="font-black text-stone-900 mb-2">'+title+'</h4><ul class="space-y-2 text-sm leading-7 text-stone-700">'+arr.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul></div>';
    }
    function render(root,data){
      var cur=data.current, d=data.daily;
      var info=wInfo(cur.weather_code);
      var tmax=Math.round(d.temperature_2m_max[0]), tmin=Math.round(d.temperature_2m_min[0]);
      var precip=d.precipitation_probability_max[0], uv=d.uv_index_max[0];
      var windKmh=cur.wind_speed_10m, bf=beaufort(windKmh);
      var adv=buildAdvice({code:cur.weather_code,tmax:tmax,tmin:tmin,precip:precip,uv:uv,bf:bf});
      var risks = adv.risks.length
        ? '<div class="rounded-2xl border border-red-300 bg-red-50 p-5"><h4 class="font-black text-red-700 mb-2">⚠️ تنبيهات جوية</h4><ul class="space-y-2 text-sm leading-7 text-red-800">'+adv.risks.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul></div>'
        : '<div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-800">✅ لا توجد تنبيهات جوية خطيرة حالياً.</div>';
      var wd=['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
      var days='';
      for(var i=0;i<d.time.length;i++){
        var dt=new Date(d.time[i]+'T00:00');
        var wname=i===0?'اليوم':wd[dt.getDay()];
        var c=wInfo(d.weather_code[i]);
        days+='<div class="flex-1 min-w-[112px] rounded-2xl border border-white/40 bg-white/70 p-4 text-center"><div class="text-sm font-bold text-stone-500">'+wname+'</div><div class="text-3xl my-2">'+c.i+'</div><div class="text-sm text-stone-700">'+c.t+'</div><div class="mt-2 font-black text-stone-900">'+Math.round(d.temperature_2m_max[i])+'° / '+Math.round(d.temperature_2m_min[i])+'°</div><div class="text-xs text-[#2f6f8f] mt-1">💧 '+d.precipitation_probability_max[i]+'%</div></div>';
      }
      root.innerHTML =
        '<div class="grid gap-6 lg:grid-cols-3">'+
          '<div class="lg:col-span-1 card p-7">'+
            '<div class="flex items-center gap-4"><div class="text-6xl">'+info.i+'</div><div><div class="text-4xl font-black">'+Math.round(cur.temperature_2m)+'°</div><div class="text-stone-600">'+info.t+'</div></div></div>'+
            '<div class="mt-5 grid grid-cols-2 gap-3 text-sm">'+
              '<div class="rounded-xl bg-black/5 p-3"><div class="text-stone-500">العظمى / الصغرى</div><div class="font-black text-stone-900">'+tmax+'° / '+tmin+'°</div></div>'+
              '<div class="rounded-xl bg-black/5 p-3"><div class="text-stone-500">احتمال المطر</div><div class="font-black text-stone-900">'+precip+'%</div></div>'+
              '<div class="rounded-xl bg-black/5 p-3"><div class="text-stone-500">الرياح</div><div class="font-black text-stone-900">'+Math.round(windKmh)+' كم/س ('+bf+' بفورت)</div></div>'+
              '<div class="rounded-xl bg-black/5 p-3"><div class="text-stone-500">الأشعة UV</div><div class="font-black text-stone-900">'+uv+'</div></div>'+
            '</div>'+
          '</div>'+
          '<div class="lg:col-span-2 space-y-4">'+
            risks+
            '<div class="grid gap-4 sm:grid-cols-3">'+
              block('👕 ملابس مقترحة',adv.outfit)+
              block('🗺 ترتيب الزيارة',adv.play)+
              block('🎒 أغراض تصطحبها',adv.items)+
            '</div>'+
          '</div>'+
        '</div>'+
        '<div class="mt-8"><h3 class="mb-3 text-lg font-black text-stone-900">توقّعات 7 أيام</h3><div class="flex gap-3 overflow-x-auto pb-2">'+days+'</div></div>';
    }
    function load(){
      var root=document.getElementById('weather-root');
      if(!root)return;
      var lat=root.getAttribute('data-lat'), lon=root.getAttribute('data-lon');
      var url='https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lon+'&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max,uv_index_max,wind_gusts_10m_max&timezone=auto&forecast_days=7';
      root.innerHTML='<div class="card p-8 text-stone-500">جارٍ تحميل الطقس…</div>';
      fetch(url).then(function(r){return r.json();}).then(function(data){render(root,data);}).catch(function(){
        root.innerHTML='<div class="card p-8 text-stone-600">تعذّر تحميل الطقس الآن. جرّب لاحقاً أو تحقّق من اتصالك بالإنترنت.</div>';
      });
    }
    if(document.readyState!=='loading'){load();}else{document.addEventListener('DOMContentLoaded',load);}
  })();
  </script>
</body>
</html>
