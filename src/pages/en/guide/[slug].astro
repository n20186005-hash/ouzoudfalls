---
import TopicPage from '../../../components/TopicPage.astro';
import { topicSlugs } from '../../../content/topics';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
  return topicSlugs.map((slug) => ({ params: { slug }, props: { locale: 'en' as Locale } }));
}
const { slug, locale } = Astro.props;
---
<TopicPage locale={locale} slug={slug} />
