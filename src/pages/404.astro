---
import '../styles/global.css';
import {locales,localeMeta,pagePath} from '../i18n';
---
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>404 — الصفحة غير موجودة | Page not found</title><meta name="robots" content="noindex,follow"/><link rel="canonical" href="https://ouzoudfalls.com/404/"/></head><body><main class="mx-auto max-w-3xl px-5 py-20"><h1 class="text-4xl font-bold">404 — الصفحة غير موجودة</h1><p lang="en" class="mt-5">Page not found.</p><p lang="fr">Page introuvable.</p><p lang="zh">找不到此页面。</p><nav class="mt-6 flex flex-wrap gap-5">{locales.map(l=><a class="underline" lang={localeMeta[l].htmlLang} href={pagePath(l)}>{localeMeta[l].label} ↗</a>)}</nav></main></body></html>
